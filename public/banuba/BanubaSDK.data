    vec2 bg_uv = (gl_Position.xy / gl_Position.w) * 0.5 + 0.5;
#ifdef BNB_VK_1
    bg_uv.y = 1. - bg_uv.y;
#endif
    var_uv = vec4(attrib_uv, bg_uv);

    mat3 mv0_3 = mat3(bnb_MV[0].xyz, bnb_MV[1].xyz, bnb_MV[2].xyz);
