                    "materials": ["mat_video_texture"]
                },
                "transformation_3d": {
                    "@rotation": [0.0, 0.0, 0.0],
                    "@scale": [1.0, 1.0, 1.0],
                    "@translation": [0.0, 0.0, 0.0]
                }
            },
            "layer": "video_texture:@face_idx"
        }
    },
    "hierarchy": {
