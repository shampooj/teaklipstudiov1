{
    "type": "object",
    "description": "Place 3D model in GLTF format on the face.",
    "required": [
        "@mesh"
    ],
    "properties": {
        "@mesh": {
            "type": "string",
            "description": "Path to a GLTF model. Note the leading `@` in the parameter, it is mandatory. Supported formats: `.glb`, `.gltf`. Note that all included files, such as GLTF model, shaders, textures, sounds (if there are any), must be located in one folder."
        },
        "@use_physics": {
            "type": "boolean",
            "default": false,
            "description": "Load GLTF with physics simulation. Note the leading `@` in the parameter, it is mandatory."
        },
        "cut": {
            "type": "string",
            "default": "",
            "description": "Enabling cutting geometry. Available values: 'head', 'head_with_ears'."
        },
        "translation": {
            "type": "string",
            "default": "0 0 0",
            "description": "Translate the model along _X_, _Y_, _Z_ axes (in millimetres)."
        },
        "scale": {
            "type": "string",
            "default": "1 1 1",
            "description": "Scale along _X_, _Y_, _Z_ axes."
        },
        "rotation": {
            "type": "string",
            "default": "-90 0 0",
            "description": "Rotation angles (in degrees) over _X_, _Y_, _Z_ axes. Note the default value."
        },
        "gravity": {
            "type": "string",
            "default": "0 0 0",
            "description": "Sets gravitation vector along _X_, _Y_, _Z_ axes"
        },
        "bones": {
            "type": "object",
            "description": "Sets bones inversed mass. Object, where key is a name of bone and parameter is an inversed mass"
        },
        "colliders": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "center": {
                        "type": "string",
                        "default": "0. 0. 0.",
                        "description": "_X_, _Y_, _Z_ coordinates of the center of sphere"
                    },
                    "radius": {
                        "type": "number",
                        "default": 0,
                        "description": "Radius of the sphere"
                    }
                }
            },
            "description": "Add sphere colliders for physical bones. Array of objects, each object is a separate collider",
            "required": [
                "center",
                "radius"
            ]
        },
        "constraints": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "from": {
                        "type": "string",
                        "default": "",
                        "description": "'From' bone name"
                    },
                    "to": {
                        "type": "string",
                        "default": "",
                        "description": "'To' bone name"
                    },
                    "distance": {
                        "type": "number",
                        "default": 0,
                        "description": "Constaint length"
                    }
                }
            },
            "description": "Add constraint between two bones. Array of objects, each object is a one constraint",
            "required": [
                "from",
                "to",
                "distance"
            ]
        },
        "bones_in_mv_space": {
            "type": "boolean",
            "default": false,
            "description": "Sets bones in MV space"
        },
        "animation": {
            "type": "object",
            "description": "Play animation from GLTF file",
            "properties": {
                "name": {
                    "type": "string",
                    "default": "",
                    "description": "Animation to play from GLTF file."
                },
                "mode": {
                    "type": "string",
                    "enum": [
                        "off",
                        "loop",
                        "once",
                        "once_reversed",
                        "fixed"
                    ],
                    "dafault": "loop",
                    "description": "How to play animation selected by 'name'"
                },
                "seek_position": {
                    "type": "integer",
                    "default": 0,
                    "description": "Where to start animation relatively from the start position (in ms)"
                }
            }
        }
    }
}'use strict';

const prefabs = require("bnb_js/prefabs");

class GltfBase extends prefabs.Base {
    constructor(faceIndex=0) {
        super();
    }
}

exports = {
    GltfBase
}
{
    "apply_order": 190,
    "assets": {
        "attachments": {
            "gltf_main_color": { "clear": [0, 0, 0, 1], "load_state": "clear", "store_state": "save", "type": "color" }
        },
        "faces": {
            "face:@face_idx": {
                "index": @face_idx,
                "mesh" : "face_stream:@face_idx"
            }
        },
        "materials":{
            "gltf_copy_color": {
                "path": "/bnb_shaders/bnb/lib/copy_pixels",
                "samplers": [ { "name": "input_color", "image": "base_main_color" } ],
                "state": {
                    "backfaces": false,
                    "blend": "off",
                    "colorwrite": true,
                    "ztest": false,
                    "zwrite": false
                }
            },
            "mat_cut": {
                "path": "/bnb_prefabs/gltf_base/shaders/mat_cut",
                "built_in_samplers": [
                    "bnb_BONES",
                    "bnb_UVMORPH_FISHEYE",
                    "bnb_MORPH"
                ],
                "samplers": [
                    {
                        "name": "bnb_BONES"
                    },
                    {
                        "name": "bnb_UVMORPH_FISHEYE"
                    },
                    {
                        "name": "bnb_MORPH"
                    }
                ],
                "state": {
                    "backfaces": false,
                    "blend": "off",
                    "colorwrite": false,
                    "ztest": true,
                    "zwrite": true
                }
            }
        },
        "meshes": {
            "face_stream:@face_idx": "$builtin$meshes/face.stream:@face_idx",
            "cut": "/bnb_prefabs/gltf_base/meshes/cut.bsm2",
            "fs_tri": "$builtin$meshes/fs_tri"
        }
    },
    "components": {
        "face_tracker:@face_idx": {
            "face": "face:@face_idx",
            "type": "face_tracker"
        }
    },
    "entities": {
        "face_tracker:@face_idx": {
            "components": ["face_tracker:@face_idx"]
        },
        "gltf_copy_color_ent": {
            "components": {
                "mesh_instance" : {
                    "mesh": "fs_tri",
                    "materials": ["gltf_copy_color"]
                }
            },
            "layer": "gltf_copy_color_layer"
        },
        "gltf:@face_idx": {
            "components": {
                "mesh_instance": {
                    "@mesh": "",
                    "@use_physics": false
                },
                "transformation_3d": {
                    "@rotation": [0.0, 0.0, 0.0],
                    "@scale": [1.0, 1.0, 1.0],
                    "@translation": [0.0, 0.0, 0.0]
                }
            },
            "layer": "gltf_layer:@face_idx"
        },
        "cut:@face_idx": {
            "components": {
                "mesh_instance": {
                    "mesh": "cut",
                    "use_physics": false,
                    "materials": ["mat_cut"]
                }
            },
            "layer": "cut_layer:@face_idx"
        }
    },
    "hierarchy": {
        "face_tracker:@face_idx": [
            "gltf:@face_idx",
            "cut:@face_idx"
        ],
        "root": [
            "face_tracker:@face_idx",
            "gltf_copy_color_ent"
        ]
    },
    "render_list": {
        "default": [
            {
                "layer": "gltf_copy_color_layer",
                "render_target": "gltf_base_rt"
            },
            {
                "layer": "cut_layer:@face_idx",
                "render_target": "gltf_base_rt"
            },
            {
                "layer": "gltf_layer:@face_idx",
                "render_target": "gltf_base_rt"
            }
        ]
    },
    "render_targets": {
        "gltf_base_rt": {
            "attachments": ["gltf_main_color", "base_main_z"],
            "@samples_count": 1
        }
    },
    "script": "/bnb_prefabs/gltf_base/config.js"
}
